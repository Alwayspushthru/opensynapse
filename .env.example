# Configure only the provider you use. DeepSeek is the default for chat and extraction.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-6.1-sol"
QWEN_API_KEY=""
# Beijing endpoint; replace with your workspace/region endpoint when needed.
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen3.7-plus"
ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_MODEL="glm-5.3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional overrides for Gemini CLI / Code Assist OAuth.
# By default, OpenSynapse will try to extract the bundled client from a local `gemini` install.
OPENSYNAPSE_GEMINI_OAUTH_CLIENT_ID="YOUR_GEMINI_CLI_OAUTH_CLIENT_ID"
OPENSYNAPSE_GEMINI_OAUTH_CLIENT_SECRET="YOUR_GEMINI_CLI_OAUTH_CLIENT_SECRET"

# Optional when your Code Assist account requires a specific project.
GOOGLE_CLOUD_PROJECT="YOUR_GOOGLE_CLOUD_PROJECT_ID"

# Development only. When not set to "0", local dev may bypass login
# and keep notes / flashcards / chat sessions in memory for faster UI debugging.
VITE_DISABLE_AUTH="1"

# ============================================
# Multi-Provider Authentication (WeChat / QQ)
# ============================================
# Required for WeChat/QQ OAuth login support
# Register at: https://open.weixin.qq.com/ (微信)
# Register at: https://connect.qq.com/ (QQ)

WECHAT_APP_ID="your_wechat_app_id"
WECHAT_APP_SECRET="your_wechat_app_secret"

QQ_APP_ID="your_qq_app_id"
QQ_APP_SECRET="your_qq_app_secret"

# ============================================
# Social Authentication Providers
# ============================================
# Configure at least one provider for user login
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
# Discord: https://discord.com/developers/applications

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# ============================================
# Self-Hosted Database Configuration
# ============================================
# PostgreSQL database URL for self-hosted mode
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://opensynapse:password@localhost:5432/opensynapse"

# Better-Auth Secret for authentication (min 32 characters)
# Used by better-auth for session signing and encryption
BETTER_AUTH_SECRET="your-super-secret-auth-key-minimum-32-chars"

# Chroma vector database (HTTP endpoint, 端口不可省略)
# 服务端读取项目根目录 .env.local（生产环境也相同）
# 默认: docker compose up -d chroma（chroma_data 命名卷）
# 手动备用: 安装 chromadb==1.5.5 CLI 后 npm run chroma（./data/chroma）
# 两种方式只运行一个，数据独立；安装、备份和切换见 docs/DEPLOYMENT_GUIDE.md
CHROMA_URL="http://127.0.0.1:8000"

# ============================================
# Alipay Payment Configuration
# ============================================
# Register at: https://open.alipay.com/
ALIPAY_APP_ID="your_alipay_app_id"
ALIPAY_PRIVATE_KEY="your_alipay_private_key"
ALIPAY_PUBLIC_KEY="your_alipay_public_key"
ALIPAY_NOTIFY_URL="https://opensynapse.top/api/payment/notify"
ALIPAY_RETURN_URL="https://opensynapse.top/payment/callback"
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# ============================================
# Commercial Deployment Notes
# ============================================
# For multi-tenant commercial deployments:
# 1. Each user's API keys are stored in PostgreSQL (api_keys table)
# 2. Global API keys above are used as fallback only
# 3. Users can configure personal API keys in Settings
# See docs/auth/environment-variables.md for full documentation
